generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 中文表名：用户表
/// 表说明：存储本地单用户或未来多用户账号的基础身份信息，是所有业务数据按用户隔离的根对象。
/// 物理表名：users
model User {
  id              String           @id @default(cuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  domains         KnowledgeDomain[]
  topics          KnowledgeTopic[]
  knowledgePoints KnowledgePoint[]
  sourceReferences SourceReference[]
  ingestionTasks   IngestionTask[]
  reviewItems      ReviewItem[]
  questions        Question[]
  coreExplanations CoreExplanation[]
  generationRecords GenerationRecord[]
  qualityCheckRecords QualityCheckRecord[]
  answerAttempts  AnswerAttempt[]
  masteryProfiles MasteryProfile[]
  errorSets       ErrorSet[]
  practiceSessions PracticeSession[]

  @@map("users")
}

/// 中文表名：知识领域表
/// 表说明：存储历史、计算机、AI、摄影等知识领域，用于组织主题、知识点和领域级掌握画像。
/// 物理表名：knowledge_domains
model KnowledgeDomain {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  name            String
  description     String?
  trustPolicyJson String?          @map("trust_policy_json")
  sortOrder       Int              @default(0) @map("sort_order")
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id])
  topics          KnowledgeTopic[]
  knowledgePoints KnowledgePoint[]

  @@unique([userId, name])
  @@index([userId, status])
  @@map("knowledge_domains")
}

/// 中文表名：知识主题表
/// 表说明：存储某个知识领域下较成体系的学习主题，例如 GitHub Actions，用于承载主题大纲和知识点集合。
/// 物理表名：knowledge_topics
model KnowledgeTopic {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  domainId        String           @map("domain_id")
  name            String
  description     String?
  outlineJson     String?          @map("outline_json")
  suggestedLevel  String?          @map("suggested_level")
  status          String           @default("confirmed")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id])
  domain          KnowledgeDomain  @relation(fields: [domainId], references: [id])
  knowledgePoints KnowledgePoint[]

  @@unique([domainId, name])
  @@index([userId, status])
  @@index([domainId, status])
  @@map("knowledge_topics")
}

/// 中文表名：知识类型表
/// 表说明：存储概念类、操作类、原理类等知识类型及讲解模板，用于指导不同知识点的讲解和出题方式。
/// 物理表名：knowledge_types
model KnowledgeType {
  id                      String           @id @default(cuid())
  userId                  String?          @map("user_id")
  code                    String           @unique
  name                    String
  description             String?
  explanationTemplateJson String           @map("explanation_template_json")
  status                  String           @default("active")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  knowledgePoints         KnowledgePoint[]

  @@index([status])
  @@map("knowledge_types")
}

/// 中文表名：知识点表
/// 表说明：存储可被讲解、出题、练习和评估的最小学习单元，并关联领域、主题和知识类型。
/// 物理表名：knowledge_points
model KnowledgePoint {
  id                  String          @id @default(cuid())
  userId              String          @map("user_id")
  domainId            String          @map("domain_id")
  topicId             String          @map("topic_id")
  knowledgeTypeId     String          @map("knowledge_type_id")
  name                String
  description         String?
  complexityLevel     String          @default("medium") @map("complexity_level")
  suggestedDifficulty Int             @default(3) @map("suggested_difficulty")
  status              String          @default("confirmed")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  user                User            @relation(fields: [userId], references: [id])
  domain              KnowledgeDomain @relation(fields: [domainId], references: [id])
  topic               KnowledgeTopic  @relation(fields: [topicId], references: [id])
  knowledgeType       KnowledgeType   @relation(fields: [knowledgeTypeId], references: [id])
  questions           Question[]
  coreExplanations    CoreExplanation[]

  @@unique([topicId, name])
  @@index([userId, status])
  @@index([domainId, status])
  @@index([topicId, status])
  @@map("knowledge_points")
}

/// 中文表名：来源引用表
/// 表说明：记录外部会话、文档、链接等知识来源，保留来源系统、原文或摘要和可信度，支持溯源审计。
/// 物理表名：source_references
model SourceReference {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  sourceType        String          @map("source_type")
  sourceSystem      String?         @map("source_system")
  sourceTitle       String?         @map("source_title")
  sourceContent     String?         @map("source_content")
  sourceSummary     String?         @map("source_summary")
  sourceUrlOrFileId String?         @map("source_url_or_file_id")
  conversationId    String?         @map("conversation_id")
  sourceTimestamp   DateTime?       @map("source_timestamp")
  trustLevel        String          @default("medium") @map("trust_level")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  user              User            @relation(fields: [userId], references: [id])
  ingestionTasks    IngestionTask[]

  @@index([userId, sourceType])
  @@index([sourceSystem, conversationId])
  @@map("source_references")
}

/// 中文表名：知识沉淀任务表
/// 表说明：记录主题学习、即时掌握、外部会话沉淀等任务的输入、状态、预览结果和幂等键。
/// 物理表名：ingestion_tasks
model IngestionTask {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  ingestionType     String           @map("ingestion_type")
  sourceReferenceId String?          @map("source_reference_id")
  requestedBy       String           @map("requested_by")
  instruction       String
  status            String           @default("submitted")
  idempotencyKey    String?          @map("idempotency_key")
  resultPreviewJson String?          @map("result_preview_json")
  errorMessage      String?          @map("error_message")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id])
  sourceReference   SourceReference? @relation(fields: [sourceReferenceId], references: [id])
  reviewItems       ReviewItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, ingestionType])
  @@map("ingestion_tasks")
}

/// 中文表名：待确认项表
/// 表说明：存储 AI 生成后需要用户确认、编辑或拒绝的待办项，是正式入库前的统一业务闸门。
/// 物理表名：review_items
model ReviewItem {
  id              String         @id @default(cuid())
  userId          String         @map("user_id")
  ingestionTaskId String?        @map("ingestion_task_id")
  targetType      String         @map("target_type")
  targetId        String         @map("target_id")
  previewJson     String         @map("preview_json")
  status          String         @default("pending")
  confirmedAt     DateTime?      @map("confirmed_at")
  rejectedAt      DateTime?      @map("rejected_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id])
  ingestionTask   IngestionTask? @relation(fields: [ingestionTaskId], references: [id])

  @@index([userId, status])
  @@index([ingestionTaskId])
  @@map("review_items")
}

/// 中文表名：题目表
/// 表说明：存储题目的稳定业务身份、认知维度、难度、状态和所属知识点，具体题干通过题目版本表管理。
/// 物理表名：questions
model Question {
  id                 String                  @id @default(cuid())
  userId             String                  @map("user_id")
  knowledgePointId   String                  @map("knowledge_point_id")
  questionType       String                  @map("question_type")
  cognitiveDimension String                  @map("cognitive_dimension")
  difficultyLevel    Int                     @default(3) @map("difficulty_level")
  status             String                  @default("pending_confirmation")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  user               User                    @relation(fields: [userId], references: [id])
  knowledgePoint     KnowledgePoint          @relation(fields: [knowledgePointId], references: [id])
  versions           QuestionVersion[]
  answerVersions     AnswerVersion[]
  rubricVersions     ScoringRubricVersion[]
  qualityChecks      QualityCheckRecord[]
  answerAttempts     AnswerAttempt[]
  practiceItems      PracticeSessionItem[]

  @@index([userId, status])
  @@index([knowledgePointId, status])
  @@index([knowledgePointId, cognitiveDimension])
  @@map("questions")
}

/// 中文表名：题目版本表
/// 表说明：存储题干和题目内容的版本化快照，保留生成来源、模型和 Agent 信息，确保历史答题可追溯。
/// 物理表名：question_versions
model QuestionVersion {
  id              String    @id @default(cuid())
  questionId      String    @map("question_id")
  versionNo       Int       @map("version_no")
  stem            String
  contentJson     String?   @map("content_json")
  sourceType      String    @default("ai_generated") @map("source_type")
  modelName       String?   @map("model_name")
  aiAgent         String?   @map("ai_agent")
  promptVersion   String?   @map("prompt_version")
  status          String    @default("draft")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  question        Question  @relation(fields: [questionId], references: [id])
  answerAttempts  AnswerAttempt[]

  @@unique([questionId, versionNo])
  @@index([questionId, status])
  @@map("question_versions")
}

/// 中文表名：标准答案版本表
/// 表说明：存储题目标准答案和答案讲解的版本化快照，支持答案迭代和历史答题绑定。
/// 物理表名：answer_versions
model AnswerVersion {
  id              String    @id @default(cuid())
  questionId      String    @map("question_id")
  versionNo       Int       @map("version_no")
  answerText      String    @map("answer_text")
  explanationText String?   @map("explanation_text")
  sourceType      String    @default("ai_generated") @map("source_type")
  modelName       String?   @map("model_name")
  aiAgent         String?   @map("ai_agent")
  promptVersion   String?   @map("prompt_version")
  status          String    @default("draft")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  question        Question  @relation(fields: [questionId], references: [id])
  answerAttempts  AnswerAttempt[]

  @@unique([questionId, versionNo])
  @@index([questionId, status])
  @@map("answer_versions")
}

/// 中文表名：评分规则版本表
/// 表说明：存储题目评分规则的版本化 JSON，答题评分必须绑定当时使用的评分规则版本。
/// 物理表名：scoring_rubric_versions
model ScoringRubricVersion {
  id              String    @id @default(cuid())
  questionId      String    @map("question_id")
  versionNo       Int       @map("version_no")
  rubricJson      String    @map("rubric_json")
  sourceType      String    @default("ai_generated") @map("source_type")
  modelName       String?   @map("model_name")
  aiAgent         String?   @map("ai_agent")
  promptVersion   String?   @map("prompt_version")
  status          String    @default("draft")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  question        Question  @relation(fields: [questionId], references: [id])
  answerAttempts  AnswerAttempt[]

  @@unique([questionId, versionNo])
  @@index([questionId, status])
  @@map("scoring_rubric_versions")
}

/// 中文表名：核心讲解表
/// 表说明：存储知识点核心讲解的稳定业务身份和状态，具体讲解内容通过核心讲解版本表管理。
/// 物理表名：core_explanations
model CoreExplanation {
  id                 String                   @id @default(cuid())
  userId             String                   @map("user_id")
  knowledgePointId   String                   @map("knowledge_point_id")
  status             String                   @default("pending_confirmation")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  user               User                     @relation(fields: [userId], references: [id])
  knowledgePoint     KnowledgePoint           @relation(fields: [knowledgePointId], references: [id])
  versions           CoreExplanationVersion[]

  @@index([userId, status])
  @@index([knowledgePointId, status])
  @@map("core_explanations")
}

/// 中文表名：核心讲解版本表
/// 表说明：存储知识点核心讲解内容的版本化快照，并记录采用的知识类型模板、模型和 Agent 来源。
/// 物理表名：core_explanation_versions
model CoreExplanationVersion {
  id                String          @id @default(cuid())
  coreExplanationId String          @map("core_explanation_id")
  versionNo         Int             @map("version_no")
  title             String
  explanationText   String          @map("explanation_text")
  templateCode      String?         @map("template_code")
  sourceType        String          @default("ai_generated") @map("source_type")
  modelName         String?         @map("model_name")
  aiAgent           String?         @map("ai_agent")
  promptVersion     String?         @map("prompt_version")
  status            String          @default("draft")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  coreExplanation   CoreExplanation @relation(fields: [coreExplanationId], references: [id])

  @@unique([coreExplanationId, versionNo])
  @@index([coreExplanationId, status])
  @@map("core_explanation_versions")
}

/// 中文表名：生成记录表
/// 表说明：记录 AI 生成题目、答案、评分规则、核心讲解等内容时的模型、Agent、提示词版本、token、耗时和成本。
/// 物理表名：generation_records
model GenerationRecord {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  targetType      String   @map("target_type")
  targetId        String   @map("target_id")
  callType        String   @map("call_type")
  modelName       String   @map("model_name")
  modelVersion    String?  @map("model_version")
  aiAgent         String   @map("ai_agent")
  promptVersion   String   @map("prompt_version")
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  latencyMs       Int?     @map("latency_ms")
  cost            Decimal? @map("cost")
  status          String   @default("success")
  promptHash      String?  @map("prompt_hash")
  responseHash    String?  @map("response_hash")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId, targetType, targetId])
  @@index([modelName, aiAgent])
  @@index([createdAt])
  @@map("generation_records")
}

/// 中文表名：质量校验记录表
/// 表说明：记录题目、答案、评分规则等内容的规则校验和 AI 质检结果，以及自动修正次数和通过状态。
/// 物理表名：quality_check_records
model QualityCheckRecord {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  questionId        String?   @map("question_id")
  targetType        String    @map("target_type")
  targetId          String    @map("target_id")
  checkerType       String    @map("checker_type")
  modelName         String?   @map("model_name")
  aiAgent           String?   @map("ai_agent")
  ruleResultJson    String?   @map("rule_result_json")
  aiResultJson      String?   @map("ai_result_json")
  autoFixCount      Int       @default(0) @map("auto_fix_count")
  status            String    @default("pending")
  passedAt          DateTime? @map("passed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id])
  question          Question? @relation(fields: [questionId], references: [id])

  @@index([userId, status])
  @@index([questionId, status])
  @@index([targetType, targetId])
  @@map("quality_check_records")
}

/// 中文表名：答题记录表
/// 表说明：记录用户一次答题的答案、AI 评分、用户确认评分、错误原因标签和是否计入长期掌握画像。
/// 物理表名：answer_attempts
model AnswerAttempt {
  id                     String                @id @default(cuid())
  userId                 String                @map("user_id")
  questionId             String                @map("question_id")
  questionVersionId      String                @map("question_version_id")
  answerVersionId        String                @map("answer_version_id")
  scoringRubricVersionId String                @map("scoring_rubric_version_id")
  userAnswer             String                @map("user_answer")
  aiScore                Int                   @map("ai_score")
  aiFeedback             String                @map("ai_feedback")
  userConfirmedScore     Int?                  @map("user_confirmed_score")
  scoreDiffReason        String?               @map("score_diff_reason")
  finalScore             Int                   @map("final_score")
  reasonTagsJson         String                @map("reason_tags_json")
  affectsMastery         Boolean               @default(true) @map("affects_mastery")
  status                 String                @default("ai_scored")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  user                   User                  @relation(fields: [userId], references: [id])
  question               Question              @relation(fields: [questionId], references: [id])
  questionVersion        QuestionVersion       @relation(fields: [questionVersionId], references: [id])
  answerVersion          AnswerVersion         @relation(fields: [answerVersionId], references: [id])
  scoringRubricVersion   ScoringRubricVersion  @relation(fields: [scoringRubricVersionId], references: [id])

  @@index([userId, status])
  @@index([questionId, createdAt])
  @@index([affectsMastery])
  @@map("answer_attempts")
}

/// 中文表名：掌握画像表
/// 表说明：存储知识点、主题或领域维度的五维掌握分、综合分、证据数量和薄弱维度摘要。
/// 物理表名：mastery_profiles
model MasteryProfile {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  targetType          String   @map("target_type")
  targetId            String   @map("target_id")
  dimensionScoresJson String   @map("dimension_scores_json")
  overallScore        Float    @map("overall_score")
  evidenceCount       Int      @default(0) @map("evidence_count")
  weakDimensionsJson  String   @map("weak_dimensions_json")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
  @@index([overallScore])
  @@map("mastery_profiles")
}

/// 中文表名：错误集表
/// 表说明：按知识点聚合低分或用户修正后的错误答题记录，保存主要错误原因标签，用于复盘和针对性提问。
/// 物理表名：error_sets
model ErrorSet {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  knowledgePointId   String   @map("knowledge_point_id")
  attemptIdsJson     String   @map("attempt_ids_json")
  dominantTagsJson   String   @map("dominant_tags_json")
  status             String   @default("active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id])

  @@unique([userId, knowledgePointId])
  @@index([userId, status])
  @@index([knowledgePointId, status])
  @@map("error_sets")
}

/// 中文表名：练习会话表
/// 表说明：记录一次针对知识点、主题或领域的练习会话目标、选题策略和会话状态。
/// 物理表名：practice_sessions
model PracticeSession {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  sessionType    String                @map("session_type")
  targetType     String                @map("target_type")
  targetId       String                @map("target_id")
  strategyJson   String                @map("strategy_json")
  status         String                @default("created")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  user           User                  @relation(fields: [userId], references: [id])
  items          PracticeSessionItem[]

  @@index([userId, status])
  @@index([userId, targetType, targetId])
  @@map("practice_sessions")
}

/// 中文表名：练习会话题目表
/// 表说明：记录练习会话中被选中的题目顺序、来源、状态和选题原因，支持解释为什么问这道题。
/// 物理表名：practice_session_items
model PracticeSessionItem {
  id                String          @id @default(cuid())
  practiceSessionId String          @map("practice_session_id")
  questionId        String          @map("question_id")
  orderNo           Int             @map("order_no")
  selectionReason   String          @map("selection_reason")
  sourceType        String          @default("confirmed_question") @map("source_type")
  status            String          @default("pending")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id])
  question          Question        @relation(fields: [questionId], references: [id])

  @@unique([practiceSessionId, questionId])
  @@index([practiceSessionId, orderNo])
  @@index([questionId, status])
  @@map("practice_session_items")
}
